# Copy this file to .env.local and fill in the values.
# .env.local is gitignored and must never be committed.
#
# The same values go into Vercel, under Settings then Environment Variables.

# ---------------------------------------------------------------------------
# Supabase. Dashboard: Project Settings, then API Keys.
# Supabase renamed these. The old names are in brackets.
# ---------------------------------------------------------------------------

# Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key (older docs call this the anon key).
# Safe to expose to the browser. Starts sb_publishable_
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret key (older docs call this the service_role key).
# Server only. Bypasses every row level security rule. Never prefix this with
# NEXT_PUBLIC_ and never paste it into a chat window or a commit.
# Starts sb_secret_
SUPABASE_SECRET_KEY=


# ---------------------------------------------------------------------------
# Resend. Only used to tell you somebody asked for a demo they cannot see.
# Sign in links are sent by Supabase, which is pointed at Resend over SMTP.
# Leave blank and requests are still recorded, just not emailed.
# ---------------------------------------------------------------------------

RESEND_API_KEY=

# Where those notices go. Defaults to info@trustscope.co.uk.
OWNER_EMAIL=

# Must be on the domain verified in Resend.
NOTIFY_FROM=IndustrialCyber <noreply@send.industrialcyber.co.uk>

# Where a reply lands. Deliberately not the sending subdomain.
REPLY_TO=info@trustscope.co.uk


# ---------------------------------------------------------------------------
# Keep alive. Any long random string. Vercel sends it back as a bearer token
# on the daily cron, and the endpoint refuses to run without it.
# ---------------------------------------------------------------------------

CRON_SECRET=
